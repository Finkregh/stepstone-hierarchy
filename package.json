{
  "name": "stepstone-hierarchy",
  "version": "0.1.0",
  "description": "Hierarical projects/tasks for stepstone",
  "main": "./dist/index.mjs",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0",
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": ["./dist/pi-extension.mjs"]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "test:ui": "vitest ui"
  },
  "keywords": [],
  "author": {
    "name": "Bruno Paz",
    "email": "oss@brunopaz.dev",
    "url": "https://brunopaz.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/finkregh/stepstone-hierarchy.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.0.0",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "typebox": "1.3.17",
    "@eslint/js": "^10.0.0",
    "@tsconfig/node24": "^24.0.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.8",
    "acorn": "^8.15.0",
    "commitlint": "^21.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.2.5",
    "tsdown": "^0.22.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.46.3",
    "vitepress": "2.0.0-alpha.19",
    "vitest": "^4.0.8"
  }
}
